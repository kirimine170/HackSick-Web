---
import { getCollection } from "astro:content";
import EmptyState from "../../components/EmptyState.astro";
import PageHero from "../../components/PageHero.astro";
import ProjectCard from "../../components/ProjectCard.astro";
import BaseLayout from "../../layouts/BaseLayout.astro";

const projects = (await getCollection("projects")).sort((a, b) => Number(b.data.featured) - Number(a.data.featured));
---

<BaseLayout title="Projects｜HackSick" description="複数のEvent，Work，Creator，Activityを束ねるHackSickの継続的なProjectを紹介します．">
  <PageHero index="03" eyebrow="PROJECTS" title="何を，仕掛けているか．" lead="単発のEventではなく，複数の活動や成果を束ね，継続して育てる企画です．" />
  <section class="listing-section section-shell">
    {projects.length > 0 ? <div class="card-grid card-grid-projects">{projects.map((project) => <ProjectCard project={project} />)}</div> : <EmptyState label="NO PROJECTS" title="公開中のProjectはありません．" description="公開できる情報が決まり次第，ここに掲載します．" />}
  </section>
</BaseLayout>
