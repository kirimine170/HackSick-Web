---
import { getCollection } from "astro:content";
import PageHero from "../components/PageHero.astro";
import TagList from "../components/TagList.astro";
import { formatDate } from "../data/site";
import BaseLayout from "../layouts/BaseLayout.astro";

const activities = (await getCollection("activities")).sort((a, b) => b.data.date.getTime() - a.data.date.getTime());
const years = [...new Set(activities.map((activity) => activity.data.date.getFullYear()))];
---

<BaseLayout title="Activities｜HackSick" description="HackSickがこれまで行ってきた活動を，年ごとの時系列で紹介します．">
  <PageHero index="02" eyebrow="ACTIVITIES" title="これまで，何をしてきたか．" lead="LT，Meetup，Workshop，Exhibitionなど，HackSickの活動実績を時系列で残すArchiveです．" />
  <section class="archive-page section-shell">
    {years.map((year) => (
      <div class="archive-year">
        <p class="archive-year-number">{year}</p>
        <ol>
          {activities.filter((activity) => activity.data.date.getFullYear() === year).map((activity) => (
            <li>
              <time datetime={activity.data.date.toISOString()}>{formatDate(activity.data.date)}</time>
              <div>
                <p>{activity.data.type}</p>
                <h2>{activity.data.event ? <a href={`/events/${activity.data.event}/`}>{activity.data.title}</a> : activity.data.title}</h2>
                <p>{activity.data.description}</p>
                <TagList tags={activity.data.tags} />
              </div>
              {activity.data.externalUrl && <a class="archive-external" href={activity.data.externalUrl} target="_blank" rel="noreferrer" aria-label={`${activity.data.title}の外部ページ`}>↗</a>}
            </li>
          ))}
        </ol>
      </div>
    ))}
  </section>
</BaseLayout>
