---
import { getCollection } from "astro:content";
import PageHero from "../components/PageHero.astro";
import TagList from "../components/TagList.astro";
import { eventFormatLabels, formatDate } from "../data/site";
import BaseLayout from "../layouts/BaseLayout.astro";

const [activityEntries, events] = await Promise.all([getCollection("activities"), getCollection("events")]);
const activities = activityEntries.sort((a, b) => b.data.date.getTime() - a.data.date.getTime());
const eventsById = new Map(events.map((event) => [event.id, event]));
const years = [...new Set(activities.map((activity) => activity.data.date.getFullYear()))];
---

<BaseLayout title="Activities｜HackSick" description="HackSickがこれまで行ってきた活動を，年ごとの時系列で紹介します．">
  <PageHero index="02" eyebrow="ACTIVITIES" title="What we did." lead="LT，Meetup，Workshop，Exhibitionなど，HackSickの活動実績を時系列で残すArchiveです．" />
  <section class="archive-page section-shell">
    {years.map((year) => (
      <div class="archive-year">
        <p class="archive-year-number">{year}</p>
        <ol>
          {activities.filter((activity) => activity.data.date.getFullYear() === year).map((activity) => {
            const event = activity.data.event ? eventsById.get(activity.data.event) : undefined;
            return (
              <li>
                <time datetime={activity.data.date.toISOString()}>{formatDate(activity.data.date)}</time>
                <div>
                  <p>{activity.data.type}</p>
                  <h2>{activity.data.event ? <a href={`/events/${activity.data.event}/`}>{activity.data.title}</a> : activity.data.title}</h2>
                  <p>{activity.data.description}</p>
                  {event && (
                    <dl class="archive-event-meta">
                      <div><dt>FORMAT</dt><dd>{eventFormatLabels[event.data.format]}</dd></div>
                      {event.data.sponsors.length > 0 && <div><dt>SPONSORS</dt><dd>{event.data.sponsors.join("，")}</dd></div>}
                    </dl>
                  )}
                  <TagList tags={activity.data.tags} />
                </div>
                {activity.data.externalUrl && <a class="archive-external" href={activity.data.externalUrl} target="_blank" rel="noreferrer" aria-label={`${activity.data.title}の外部ページ`}>↗</a>}
              </li>
            );
          })}
        </ol>
      </div>
    ))}
  </section>
</BaseLayout>
