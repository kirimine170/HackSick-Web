---
import { getCollection, render, type CollectionEntry } from "astro:content";
import EventCard from "../../components/EventCard.astro";
import ProjectCard from "../../components/ProjectCard.astro";
import SectionHeading from "../../components/SectionHeading.astro";
import TagList from "../../components/TagList.astro";
import WorkCard from "../../components/WorkCard.astro";
import BaseLayout from "../../layouts/BaseLayout.astro";

export async function getStaticPaths() {
  const creators = await getCollection("creators");
  return creators.map((creator) => ({ params: { slug: creator.id }, props: { creator } }));
}

interface Props { creator: CollectionEntry<"creators"> }
const { creator } = Astro.props as Props;
const { Content } = await render(creator);
const [allProjects, allWorks, allEvents] = await Promise.all([getCollection("projects"), getCollection("works"), getCollection("events")]);
const projects = allProjects.filter((project) => creator.data.projects.includes(project.id));
const works = allWorks.filter((work) => creator.data.works.includes(work.id));
const events = allEvents.filter((event) => creator.data.events.includes(event.id)).sort((a, b) => b.data.startDate.getTime() - a.data.startDate.getTime());
const socialLinks = [creator.data.website && { label: "Website", url: creator.data.website }, creator.data.portfolioUrl && { label: "Portfolio", url: creator.data.portfolioUrl }, creator.data.github && { label: "GitHub", url: creator.data.github }, creator.data.x && { label: "X", url: creator.data.x }, creator.data.instagram && { label: "Instagram", url: creator.data.instagram }, ...creator.data.otherLinks].filter(Boolean) as { label: string; url: string }[];
---

<BaseLayout title={`${creator.data.name}｜Creators｜HackSick`} description={creator.data.profile} image={creator.data.profileImage}>
  <article class="detail-page creator-detail">
    <header class="detail-hero section-shell creator-detail-hero">
      <div class="creator-detail-mark" aria-hidden="true"><img src="/images/hacksick-icon.webp" alt="" width="1000" height="1000" /></div>
      <div>
        <p class="eyebrow"><span>CREATOR</span>PROFILE</p>
        <h1>{creator.data.name}</h1>
        <p>{creator.data.profile}</p>
        <TagList tags={creator.data.fields} />
      </div>
    </header>
    <div class="detail-body section-shell prose"><Content /></div>
    {socialLinks.length > 0 && <nav class="social-links section-shell" aria-label="Creatorの外部リンク">{socialLinks.map((link) => <a href={link.url} target="_blank" rel="noreferrer">{link.label} ↗</a>)}</nav>}
    {projects.length > 0 && <section class="related-section section-shell"><SectionHeading eyebrow="PROJECTS" title="関わっているProject．" /><div class="card-grid">{projects.map((project) => <ProjectCard project={project} />)}</div></section>}
    {works.length > 0 && <section class="related-section section-shell"><SectionHeading eyebrow="WORKS" title="つくったもの．" /><div class="card-grid card-grid-works">{works.map((work) => <WorkCard work={work} />)}</div></section>}
    {events.length > 0 && <section class="related-section section-shell"><SectionHeading eyebrow="EVENTS" title="関わったEvent．" /><div class="card-grid">{events.map((event) => <EventCard event={event} compact />)}</div></section>}
  </article>
</BaseLayout>
