---
import PageHero from "../components/PageHero.astro";
import { contact, links } from "../data/site";
import BaseLayout from "../layouts/BaseLayout.astro";
---

<BaseLayout title="Contact｜HackSick" description="HackSickとの共同企画，制作，研究，取材，支援・協賛に関するお問い合わせ窓口です．">
  <PageHero index="08" eyebrow="CONTACT" title="一緒に，世界をつくりませんか？" lead="共同企画，制作，研究，取材，協賛．まだ名前のないアイデアも，HackSickと一緒に形にしていきましょう．" />
  <section class="contact-page section-shell" id="contact">
    <div>
      <p class="eyebrow"><span>01</span>CONTACT ROUTES</p>
      <h2>そのアイデアを，<br />聞かせてください．</h2>
    </div>
    <div class="contact-routes">
      <a class="contact-route-email" href={contact.emailHref}>
        <span>PRIMARY CONTACT / EMAIL</span>
        <strong>{contact.email}</strong>
        <small>一般のお問い合わせ／共同企画／制作／研究／取材／協賛／連携</small>
        <i aria-hidden="true">→</i>
      </a>
      <a href={links.x} target="_blank" rel="noreferrer">
        <span>SNS / ANNOUNCEMENTS</span>
        <strong>HackSick on X</strong>
        <small>最新情報・活動のお知らせ・SNSでの交流</small>
        <i aria-hidden="true">↗</i>
      </a>
      <a href={links.connpass} target="_blank" rel="noreferrer">
        <span>EVENT INFORMATION / REGISTRATION</span>
        <strong>connpass</strong>
        <small>イベント情報・参加登録</small>
        <i aria-hidden="true">↗</i>
      </a>
    </div>
    <p class="contact-note">共同企画，制作，研究，取材，協賛などのご相談は，メールでお待ちしています．</p>
  </section>
</BaseLayout>
