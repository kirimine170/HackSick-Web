---
import PageHero from "../components/PageHero.astro";
import { links } from "../data/site";
import BaseLayout from "../layouts/BaseLayout.astro";
---

<BaseLayout title="Contact｜HackSick" description="HackSickとの共同企画，制作，研究，取材，支援・協賛に関するお問い合わせ窓口です．">
  <PageHero index="08" eyebrow="CONTACT" title="一緒に，何をつくりますか．" lead="共同企画，制作，研究，展示，取材，支援・協賛など，HackSickとの協働についてご相談ください．" />
  <section class="contact-page section-shell" id="collaborate">
    <div>
      <p class="eyebrow"><span>01</span>CONTACT ROUTES</p>
      <h2>公開されている窓口から，<br />ご連絡ください．</h2>
    </div>
    <div class="contact-routes">
      <a href={links.x} target="_blank" rel="noreferrer"><span>GENERAL / COLLABORATE</span><strong>HackSick on X</strong><i aria-hidden="true">↗</i></a>
      <a href={links.connpass} target="_blank" rel="noreferrer"><span>EVENT</span><strong>connpass</strong><i aria-hidden="true">↗</i></a>
    </div>
    <p class="contact-note">個人情報を含む連絡先は，確認できた公式窓口だけを掲載しています．メールアドレス等の追加窓口は，運営確認後に更新します．</p>
  </section>
</BaseLayout>
