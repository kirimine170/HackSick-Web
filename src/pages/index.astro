---
import { getCollection } from "astro:content";
import About from "../components/About.astro";
import Hero from "../components/Hero.astro";
import Join from "../components/Join.astro";
import Philosophy from "../components/Philosophy.astro";
import NewsList from "../components/NewsList.astro";
import HackSickStructure from "../components/HackSickStructure.astro";
import { formatDateTime } from "../data/site";
import BaseLayout from "../layouts/BaseLayout.astro";

const [events, projects] = await Promise.all([
  getCollection("events"),
  getCollection("projects"),
]);

const activeProject = projects
  .filter((project) => project.data.status === "ongoing")
  .sort((a, b) => (b.data.startDate?.getTime() ?? 0) - (a.data.startDate?.getTime() ?? 0))[0];
const news = (await getCollection("news")).sort((a,b) => b.data.date.getTime() - a.data.date.getTime()).slice(0, 3);
const upcomingEvent = events
  .filter((event) => event.data.status === "upcoming" || event.data.status === "ongoing")
  .sort((a, b) => a.data.startDate.getTime() - b.data.startDate.getTime())[0];

const exploreLinks = [
  {
    label: "ACTIVITIES",
    title: "活動記録",
    description: "これまでの動きを、時系列で読む。",
    href: "/activities/",
  },
  {
    label: "PROJECTS",
    title: "企画",
    description: "継続する企画の全体像を見る。",
    href: "/projects/",
  },
  {
    label: "WORKS",
    title: "制作物",
    description: "公開した本や作品を見る。",
    href: "/works/",
  },
  {
    label: "EVENTS",
    title: "イベント",
    description: "開催情報と過去回を確認する。",
    href: "/events/",
  },
  {
    label: "CREATORS",
    title: "つくる人",
    description: "HackSickに関わるCreatorを知る。",
    href: "/creators/",
  },
] as const;
---

<BaseLayout>
  <Hero />
  <section class="section-shell home-news"><p class="eyebrow"><span>LATEST</span>NEWS</p><h2>HackSickの最新情報</h2><NewsList items={news} /><a class="button" href="/news/">すべてのNewsを見る →</a></section>
  <About />

  <section class="home-status" aria-label="HackSickの現在の活動">
    <div class="home-status-inner">
      <p class="home-status-heading"><span>LIVE</span><strong>WHAT'S HAPPENING</strong></p>
      <a class="home-status-item" href={activeProject ? `/projects/${activeProject.id}/` : "/projects/"}>
        <span>ONGOING PROJECT</span>
        <strong>{activeProject?.data.title ?? "PROJECTS"}</strong>
        <small>{activeProject ? "進行中の企画を見る。" : "企画の現在地を見る。"}</small>
        <i aria-hidden="true">→</i>
      </a>
      <a class="home-status-item" href={upcomingEvent ? `/events/${upcomingEvent.id}/` : "/events/"}>
        <span>NEXT EVENT</span>
        <strong>{upcomingEvent?.data.title ?? "HackSick LT / 月1回開催"}</strong>
        <small>{upcomingEvent ? formatDateTime(upcomingEvent.data.startDate) : "最終土曜日を目安に開催．最新の募集情報へ．"}</small>
        <i aria-hidden="true">→</i>
      </a>
    </div>
  </section>

  <HackSickStructure />
  <Philosophy />

  <section class="home-explore section-shell" aria-labelledby="explore-title">
    <div class="section-label">
      <p><span>04</span> EXPLORE</p>
      <p>詳しくは、各ページへ。</p>
    </div>
    <div class="explore-intro">
      <h2 id="explore-title">HackSickの足跡</h2>
      <p>企画、作品、イベント、つくる人。知りたい入口から、HackSickの活動を辿れます。</p>
    </div>
    <nav class="explore-links" aria-label="活動ページ">
      {exploreLinks.map((item, index) => (
        <a class="explore-link" href={item.href}>
          <span class="explore-number">{String(index + 1).padStart(2, "0")}</span>
          <span class="explore-name"><strong>{item.label}</strong><small>{item.title}</small></span>
          <span class="explore-description">{item.description}</span>
          <i aria-hidden="true">↘</i>
        </a>
      ))}
    </nav>
  </section>

  <Join />
</BaseLayout>
