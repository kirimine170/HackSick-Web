---
import { latestEvent, links } from "../data/site";
---

<section class="latest section-shell" id="latest" aria-labelledby="latest-title">
  <div class="section-label">
    <p><span>05</span> LATEST ACTIVITY</p>
    <p>公開されている直近の活動．</p>
  </div>
  <div class="latest-grid">
    <div class="event-number" aria-hidden="true">{latestEvent.number}</div>
    <div class="event-main">
      <p class="event-date"><time datetime={latestEvent.date}>{latestEvent.displayDate}</time></p>
      <p class="event-kicker">HACKSICK LIGHTNING TALKS</p>
      <h2 id="latest-title">{latestEvent.title}</h2>
      <p class="event-theme">{latestEvent.theme}</p>
      <p class="event-venue">{latestEvent.venue}</p>
      <a class="button button-light" href={latestEvent.url} target="_blank" rel="noreferrer">
        イベント詳細 <span aria-hidden="true">↗</span>
      </a>
    </div>
    <div class="event-art" aria-hidden="true">
      <div class="event-orb"></div>
      <p>AI<br />LLM</p>
    </div>
  </div>
  <a class="archive-link" href={links.connpass} target="_blank" rel="noreferrer">
    これまでのイベントをconnpassで見る <span aria-hidden="true">↗</span>
  </a>
</section>
