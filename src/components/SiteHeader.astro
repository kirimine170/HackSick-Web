---
import { links, navigation } from "../data/site";

const currentPath = Astro.url.pathname;
const isCurrent = (href: string) => href === "/" ? currentPath === "/" : currentPath.startsWith(href);
---

<header class="site-header">
  <a class="brand" href="/" aria-label="HackSick トップページ">
    <img
      src="/images/hacksick-wordmark.webp"
      alt="HackSick"
      width="1250"
      height="328"
    />
  </a>

  <nav class="desktop-nav" aria-label="メインナビゲーション">
    <ul>
      {navigation.map((item) => <li><a href={item.href} aria-current={isCurrent(item.href) ? "page" : undefined}>{item.label}</a></li>)}
    </ul>
  </nav>

  <a class="header-cta" href="/join/">
    Join us
    <span aria-hidden="true">→</span>
  </a>

  <details class="mobile-nav">
    <summary>
      <span>Menu</span>
      <span class="menu-icon" aria-hidden="true"></span>
    </summary>
    <nav aria-label="モバイルナビゲーション">
      <ul>
        {navigation.map((item) => <li><a href={item.href} aria-current={isCurrent(item.href) ? "page" : undefined}>{item.label}</a></li>)}
        <li><a href={links.connpass} target="_blank" rel="noreferrer">Join event ↗</a></li>
      </ul>
    </nav>
  </details>
</header>
