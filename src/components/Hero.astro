---
import { links } from "../data/site";
---

<section class="hero" aria-labelledby="hero-title">
  <div class="hero-copy">
    <p class="eyebrow"><span>01</span> CROSS-DISCIPLINARY CREATIVE COMMUNITY</p>
    <h1 id="hero-title">
      創りたいを，<br />
      <span>造りたい．</span>
    </h1>
    <p class="hero-lead">
      異なる分野の人が集まり，<br />
      知識や問いを共有し，<br class="mobile-break" />プロジェクトや作品を生み出す場所．
    </p>
    <div class="hero-actions">
      <a class="button button-dark" href={links.connpass} target="_blank" rel="noreferrer">
        イベントを見る <span aria-hidden="true">↗</span>
      </a>
      <a class="text-link" href="#about">HackSickとは <span aria-hidden="true">↓</span></a>
    </div>
  </div>

  <div class="hero-visual" aria-hidden="true">
    <div class="signal signal-a"></div>
    <div class="signal signal-b"></div>
    <div class="signal signal-c"></div>
    <div class="hero-diamond">
      <img src="/images/hacksick-icon.webp" alt="" width="1000" height="1000" />
    </div>
    <p class="visual-caption">SHALL WE<br />JUST GO<br />INSANE?</p>
  </div>

  <div class="hero-index" aria-hidden="true">
    <span>01 GATHER</span>
    <span>02 CREATE</span>
    <span>03 PUBLISH</span>
  </div>
</section>

<div class="ticker" aria-label="HackSickのキーワード">
  <div class="ticker-track">
    <div class="ticker-group">
      <span>TECHNOLOGY</span><i></i><span>RESEARCH</span><i></i><span>ART</span><i></i><span>CULTURE</span><i></i>
    </div>
    <div class="ticker-group" aria-hidden="true">
      <span>TECHNOLOGY</span><i></i><span>RESEARCH</span><i></i><span>ART</span><i></i><span>CULTURE</span><i></i>
    </div>
  </div>
</div>
