---
import { links } from "../data/site";
---

<section class="hero" aria-labelledby="hero-title">
  <div class="hero-copy">
    <p class="eyebrow"><span>01</span> CROSS-DISCIPLINARY TECH COMMUNITY</p>
    <h1 id="hero-title">
      創りたいを，<br />
      <span>造りたい．</span>
    </h1>
    <p class="hero-lead">
      分野も，前提も，違っていい．<br />
      技術が好きな人のための，<br class="mobile-break" />オープンなコミュニティ．
    </p>
    <div class="hero-actions">
      <a class="button button-dark" href={links.connpass} target="_blank" rel="noreferrer">
        イベントを見る <span aria-hidden="true">↗</span>
      </a>
      <a class="text-link" href="#about">HackSickとは <span aria-hidden="true">↓</span></a>
    </div>
  </div>

  <div class="hero-visual" aria-hidden="true">
    <div class="signal signal-a"></div>
    <div class="signal signal-b"></div>
    <div class="signal signal-c"></div>
    <div class="hero-diamond">
      <img src="/images/hacksick-icon.webp" alt="" width="1000" height="1000" />
    </div>
    <p class="visual-caption">SHALL WE<br />JUST GO<br />INSANE?</p>
  </div>

  <div class="hero-index" aria-hidden="true">
    <span>01 TALK</span>
    <span>02 BUILD</span>
    <span>03 SHARE</span>
  </div>
</section>

<div class="ticker" aria-label="HackSickのキーワード">
  <div>
    <span>ALL FIELDS</span><i></i><span>ALL MAKERS</span><i></i><span>ALL QUESTIONS</span><i></i>
    <span aria-hidden="true">ALL FIELDS</span><i aria-hidden="true"></i><span aria-hidden="true">ALL MAKERS</span><i aria-hidden="true"></i><span aria-hidden="true">ALL QUESTIONS</span><i aria-hidden="true"></i>
  </div>
</div>
