---
import type { CollectionEntry } from "astro:content";
import { formatDate } from "../data/site";
import TagList from "./TagList.astro";

interface Props {
  activities: CollectionEntry<"activities">[];
}

const { activities } = Astro.props;
---

<section class="activities section-shell" aria-labelledby="activities-title">
  <div class="section-label">
    <p><span>05</span> ACTIVITIES</p>
    <p>What we did.</p>
  </div>
  <div class="activities-heading">
    <h2 id="activities-title">問いと制作の，<br />記録を残す．</h2>
    <div>
      <p>過去の活動を，Eventとは別の時系列Archiveとして蓄積しています．</p>
      <a class="text-link" href="/activities/">活動Archiveへ <span aria-hidden="true">→</span></a>
    </div>
  </div>
  <ol class="archive-preview">
    {activities.slice(0, 4).map((activity) => (
      <li>
        <time datetime={activity.data.date.toISOString()}>{formatDate(activity.data.date)}</time>
        <div>
          <p>{activity.data.type}</p>
          <h3><a href={`/events/${activity.data.event}/`}>{activity.data.title}</a></h3>
        </div>
        <TagList tags={activity.data.tags.slice(0, 3)} />
        <span aria-hidden="true">↘</span>
      </li>
    ))}
  </ol>
</section>
