---
import SiteFooter from "../components/SiteFooter.astro";
import SiteHeader from "../components/SiteHeader.astro";
import { site, links, getXHandle } from "../data/site";
import "@fontsource-variable/noto-sans-jp";
import "@fontsource/zen-kaku-gothic-new/japanese-500.css";
import "@fontsource/zen-kaku-gothic-new/japanese-700.css";
import "@fontsource/zen-kaku-gothic-new/japanese-900.css";
import "../styles/global.css";

interface Props {
  title?: string;
  description?: string;
  image?: string;
  imageWidth?: number;
  imageHeight?: number;
  imageAlt?: string;
  twitterCreator?: string;
  noindex?: boolean;
  structuredData?: Record<string, unknown>;
  ogType?: "website" | "article";
}

const {
  title = site.title,
  description = site.description,
  image = "/og.png",
  imageWidth = 1200,
  imageHeight = 630,
  imageAlt = "HackSick公式サイト",
  twitterCreator,
  noindex = false,
  structuredData,
  ogType = "website",
} = Astro.props;

const canonical = new URL(Astro.url.pathname, Astro.site);
const previewBuild = import.meta.env.CF_PAGES_BRANCH === "preview";
const imageOrigin = previewBuild
  ? import.meta.env.CF_PAGES_URL || "https://preview.hacksick-web.pages.dev"
  : Astro.site;
const imageUrl = new URL(image, imageOrigin);
const imageExtension = image.split("?")[0]?.split(".").pop()?.toLowerCase();
const imageType = imageExtension === "jpg" || imageExtension === "jpeg"
  ? "image/jpeg"
  : imageExtension === "webp"
    ? "image/webp"
    : "image/png";
---

<!doctype html>
<html lang="ja">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="generator" content={Astro.generator} />
    <meta name="theme-color" content="#ffffff" />
    <meta name="description" content={description} />
    {(noindex || previewBuild) && <meta name="robots" content="noindex, nofollow" />}
    <link rel="canonical" href={canonical} />
    <link rel="icon" type="image/png" href="/favicon.png" />
    <link rel="manifest" href="/site.webmanifest" />

    <meta property="og:type" content={ogType} />
    <meta property="og:site_name" content={site.name} />
    <meta property="og:locale" content={site.locale} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={imageUrl} />
    <meta property="og:image:type" content={imageType} />
    <meta property="og:image:width" content={String(imageWidth)} />
    <meta property="og:image:height" content={String(imageHeight)} />
    <meta property="og:image:alt" content={imageAlt} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:site" content={getXHandle(links.x)} />
    {twitterCreator && <meta name="twitter:creator" content={twitterCreator} />}
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={imageUrl} />
    <meta name="twitter:image:alt" content={imageAlt} />
    <script is:inline type="application/ld+json" set:html={JSON.stringify({
      "@context": "https://schema.org",
      "@type": "Organization",
      name: site.name,
      url: site.url,
      logo: new URL("/favicon.png", Astro.site).href,
    })}></script>
    {structuredData && <script is:inline type="application/ld+json" set:html={JSON.stringify(structuredData)}></script>}
    <title>{title}</title>
  </head>
  <body>
    <a class="skip-link" href="#main-content">本文へ移動</a>
    <div class="site-grid" aria-hidden="true"></div>
    <SiteHeader />
    <main id="main-content">
      <slot />
    </main>
    <SiteFooter />
    <script>
      import "../scripts/reveal";
    </script>
  </body>
</html>
