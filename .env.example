PUBLIC_SITE_URL=https://hacksick.com
# Preview defaults to a browser-only demo．Enable live only after configuring delivery．
PUBLIC_CONTACT_MODE=demo
# Build-time public Turnstile key．Never put the secret here．
PUBLIC_TURNSTILE_SITE_KEY=
# Cloudflare Pages runtime secrets：CONTACT_ENABLED，CONTACT_FROM，RESEND_API_KEY，TURNSTILE_SECRET_KEY
