{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "hacksick-members-local",
  "main": "src/worker.ts",
  "compatibility_date": "2026-11-03",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": false,
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "run_worker_first": true
  },
  "d1_databases": [{
    "binding": "DB",
    "database_name": "hacksick-members-local",
    "database_id": "00000000-0000-0000-0000-000000000000",
    "migrations_dir": "migrations"
  }],
  "vars": {
    "AUTH_BASE_URL": "http://localhost:8787",
    "GOOGLE_WORKSPACE_DOMAIN": "hacksick.com",
    "MAIL_FROM": "HackSick <noreply@auth.hacksick.com>"
  }
}
