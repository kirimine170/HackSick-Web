{
  "name": "@hacksick/members",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "node scripts/build.mjs",
    "check": "tsc --noEmit && tsc --noEmit -p tsconfig.client.json",
    "test": "node --test test/*.test.ts",
    "dev": "npm run build && wrangler dev --port 8787",
    "db:local": "wrangler d1 migrations apply DB --local",
    "bundle:check": "npm run build && wrangler deploy --dry-run --outdir .worker-build"
  },
  "dependencies": {
    "better-auth": "1.7.15",
    "jsqr": "1.4.0",
    "qrcode": "1.5.4"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "5.20261103.1",
    "@types/node": "26.6.6",
    "@types/qrcode": "1.5.6",
    "esbuild": "0.28.2",
    "miniflare": "5.20261103.0-beta",
    "typescript": "6.0.3",
    "wrangler": "4.157.0"
  },
  "engines": {
    "node": ">=22.18.0"
  }
}
